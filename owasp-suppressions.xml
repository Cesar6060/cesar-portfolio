  <suppress>
    <notes>False positive: CVE applies to the server component, not the client we ship.</notes>
    <packageUrl regex="true">^pkg:maven/com\.example/some-lib@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
